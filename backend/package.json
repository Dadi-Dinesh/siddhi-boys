{
  "name": "batch-fund-backend",
  "version": "1.0.0",
  "description": "Batch Fund API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "dotenv run -f ../.env -- prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:reset": "dotenv run -f ../.env -- prisma migrate reset",
    "db:studio": "dotenv run -f ../.env -- prisma studio",
    "db:deploy": "dotenv run -f ../.env -- prisma migrate deploy",
    "build": "dotenv run -f ../.env -- prisma generate"
  },
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "prisma": "^6.19.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "bcrypt@6.0.0": true,
    "fsevents": false
  },
  "engines": {
    "node": ">=20.19"
  }
}
