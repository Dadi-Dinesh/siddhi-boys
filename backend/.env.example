# ─── Required ───────────────────────────────────────────────
# PostgreSQL connection string.
# With the included docker-compose.yml, the password is POSTGRES_PASSWORD from the root .env
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/batchfund?schema=public"

# Long random string used to sign login tokens (at least 32 characters).
# The server refuses to start with this example value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your_super_secret_jwt_key"

# Address of the frontend, allowed by CORS. Required when NODE_ENV=production.
CLIENT_URL="http://localhost:5173"

# ─── Optional ───────────────────────────────────────────────
# macOS uses port 5000 for AirPlay Receiver, so the API uses 5001.
PORT=5001

# How long a login lasts before the user must log in again
JWT_EXPIRES_IN=7d

# Set to "production" on the live server (shorter error logs, CLIENT_URL required, seed blocked)
# NODE_ENV=production

# Failed logins allowed per IP address every 15 minutes (default 10)
# LOGIN_RATE_LIMIT_MAX=10

# Set to 1 when running behind a proxy / load balancer (most hosting platforms)
# TRUST_PROXY=1
