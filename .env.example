# ==========================================
# SiddhiBoys - environment variables
# Copy this file to .env at the project root and fill in the values.
# Never commit the real .env file.
# ==========================================

# ─── Backend ────────────────────────────────────────────────
# PostgreSQL connection string (e.g. from Neon)
DATABASE_URL=

# Long random string (at least 32 characters) used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Address of the deployed frontend, allowed by CORS. Required in production.
# Several addresses can be separated by commas.
CLIENT_URL=

# Port for the API (most hosting platforms set this automatically)
PORT=5001

# Set to "production" on the live server
# NODE_ENV=production

# Set to 1 when running behind a proxy / load balancer (most hosting platforms)
# TRUST_PROXY=1

# Failed logins allowed per IP address every 15 minutes (default 10)
# LOGIN_RATE_LIMIT_MAX=10

# Cloudinary (payment screenshots). Server-side only: never put these in VITE_ variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# (Alternative: one CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME instead of the three above)

# Admin account created by "npm run db:init" (only needed when running that command)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Frontend (Vite) ────────────────────────────────────────
# Public address of the backend API, ending in /api. Everything in VITE_ variables
# is visible in the browser. Leave empty in local development to use the Vite proxy.
VITE_API_URL=

# ─── Local PostgreSQL (only for docker-compose) ─────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
