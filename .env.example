# ==========================================
# Batch Fund - Single Unified Environment Example
# Copy this file to .env at the project root
# ==========================================

# PostgreSQL Database URL (e.g. Neon Cloud PostgreSQL)
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-nameless-mud-b43slx33-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Backend Server Configuration
PORT=5001
JWT_SECRET="your_long_random_jwt_secret_at_least_32_chars"
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Frontend (Vite) Configuration
VITE_API_URL=http://localhost:5001/api

# Local PostgreSQL fallback (used only if running local docker-compose)
POSTGRES_USER=batchfund
POSTGRES_PASSWORD=change-me
POSTGRES_DB=batchfund
